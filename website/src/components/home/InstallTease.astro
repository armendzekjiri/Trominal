---
import { SITE } from '@/lib/site'
---

<section class="section">
  <div class="wrap">
    <div
      style="display:grid;grid-template-columns:1.05fr 1fr;gap:48px;align-items:center"
      class="install-tease-grid"
    >
      <div>
        <span class="eyebrow">Get started in 2 minutes</span>
        <h2 style="margin-top:14px">Two commands. One server. Every platform.</h2>
        <p class="lede" style="margin-top:14px">
          Run the server with Docker Compose, point your client at it, and you're connected. The
          same vault works on macOS, Linux, and Windows — and on the web.
        </p>
        <div style="margin-top:24px;display:flex;gap:10px;flex-wrap:wrap">
          <a href="/install" class="btn btn-primary">Installation guide</a>
          <a href="/docs/self-hosting" class="btn btn-secondary">Self-hosting docs</a>
          <a href="/demo" class="btn btn-ghost">Or try the demo →</a>
        </div>
      </div>
      <div class="terminal">
        <div class="head">
          <div class="lights">
            <span style="background:#f17a7a"></span>
            <span style="background:#e0b870"></span>
            <span style="background:#7dd3a0"></span>
          </div>
          <span class="mono">~/infra</span>
        </div>
        <div class="body">
          <div class="row"><span class="term-c-dim"># Run the Trominal server</span></div>
          <div class="row">
            <span class="term-prompt">$</span> git clone <span class="term-c-green">{SITE.github.url}.git</span>
          </div>
          <div class="row"><span class="term-prompt">$</span> cd Trominal</div>
          <div class="row">
            <span class="term-prompt">$</span> ./docker/setup.sh
            <span class="term-c-dim"># writes .env with fresh secrets</span>
          </div>
          <div class="row"><span class="term-prompt">$</span> docker compose up -d</div>
          <div class="row" style="color:var(--ink-5)">→ trominal up on http://localhost</div>
          <div class="row">&nbsp;</div>
          <div class="row"><span class="term-c-dim"># Open the client</span></div>
          <div class="row" style="color:var(--ink-3)">
            → enter <span class="term-c-blue">http://localhost</span> and register
          </div>
          <div class="row" style="color:var(--accent)">✓ first user is admin</div>
          <div class="row">
            <span
              style="display:inline-block;width:7px;height:13px;background:var(--accent);animation:blink 1s step-end infinite"
            ></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 900px) {
    .install-tease-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
